# === Project ===
COMPOSE_PROJECT_NAME=myproject     # Docker prefix for volumes/networks (change to your project name)

# === Required ===
DOMAIN=example.com
DB_PASSWORD=               # openssl rand -hex 32
JWT_SECRET=                # openssl rand -hex 32
SERVER_ENCRYPTION_KEY=     # openssl rand -hex 32 (256-bit, hex-encoded)
REDIS_PASSWORD=            # openssl rand -hex 32

# === Optional (defaults shown) ===
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=myproject
DB_USER=myproject
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW=60
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800
ARGON2_TIME_COST=3
ARGON2_MEMORY=65536
ARGON2_PARALLELISM=4
